<?xml version="1.0" encoding="UTF-8"?>
<!--
  BOM publicado para consumidores. Sem parent de proposito: assim o BOM importado
  expoe apenas os artefatos LeakTrace, sem vazar o dependencyManagement de terceiros
  do parent. Manter a versao em sincronia com o parent.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.novaes7be</groupId>
    <artifactId>leaktrace-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LeakTrace :: BOM</name>
    <description>Versoes alinhadas dos artefatos LeakTrace.</description>
    <url>https://github.com/novaes7be/LeakTrace</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.novaes7be</groupId>
                <artifactId>leaktrace-annotations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.novaes7be</groupId>
                <artifactId>leaktrace-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.novaes7be</groupId>
                <artifactId>leaktrace-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.novaes7be</groupId>
                <artifactId>leaktrace-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.novaes7be</groupId>
                <artifactId>leaktrace-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
